# Copy to .env (never commit .env). All values optional; defaults shown.
# --- backend ---
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
DB_PATH=data/wind.sqlite
DECISION_CUTOFF=09:00          # HH:MM Europe/London on D-1 (assumption, see docs/DATA_METHODOLOGY.md)
MARKET_TZ=Europe/London
WINDOW_START=2026-01-01
WINDOW_END=2026-01-31
FORECAST_LOOKBACK_DAYS=4
FORECAST_LOOKAHEAD_DAYS=4
HTTP_TIMEOUT_S=30
MAPE_MIN_ACTUAL_MW=100
REFRESH_TOKEN=                 # empty = POST /api/v1/refresh disabled; set a long random value to enable
AUTO_INGEST_ON_EMPTY=true      # ingest in background on first start
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# --- frontend build ---
VITE_API_BASE_URL=             # empty = same origin (docker/nginx or Vite proxy); full URL for split hosting
